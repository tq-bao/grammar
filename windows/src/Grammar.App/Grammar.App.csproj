<Project Sdk="Microsoft.NET.Sdk">
  <!-- App Windows: WPF (panel, cài đặt) + WinForms NotifyIcon (khay hệ thống). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Grammar.App</RootNamespace>
    <AssemblyName>Grammar</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Grammar.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- LibraryImport (P/Invoke sinh mã lúc build) cần unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- App là WPF: DPI khai báo trong app.manifest (PerMonitorV2), không qua API của WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Grammar.Core\Grammar.Core.csproj" />
    <ProjectReference Include="..\Grammar.Engine\Grammar.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" />
  </ItemGroup>
  <ItemGroup>
    <!-- Icon cho khay hệ thống (sinh bằng windows/scripts/make-icon.sh). -->
    <EmbeddedResource Include="Resources\Grammar.ico" LogicalName="Grammar.App.Resources.Grammar.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Chỉ dùng WinForms cho NotifyIcon; tránh trùng tên với WPF (Application, MessageBox...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
